@startuml uml_classes
title Diagramme de classes — Domaine métier JOA LAB-FT

skinparam shadowing false
skinparam classBackgroundColor #FAFAFA
skinparam classBorderColor #444
skinparam enumBorderColor #444
skinparam packageStyle rectangle
hide circle
hide empty members

package "model.entity" as ENT {

  class Utilisateur <<Entity>> {
    - id : Long
    - identifiant : String
    - motDePasse : String  «BCrypt cost 12»
    - nom : String
    - prenom : String
    - role : RoleUtilisateur
    --
    + getNomComplet() : String
  }

  class Client <<Entity>> {
    - id : Long
    - identifie : boolean
    - nom : String
    - prenom : String
    - dateNaissance : LocalDate
    - lieuNaissance : String
    - ppe : boolean
    - rue : String
    - complement : String
    - codePostal : String
    - ville : String
    - pays : String
    - typePiece : String
    - numeroPiece : String
    - dateDelivrance : LocalDate
    - prefectureDelivrance : String
    - paysDelivrance : String
    - descriptionPhysique : String
    - dateCreation : LocalDateTime
    --
    + getLibelle() : String
    + isComplet() : boolean
    + getChampsManquants() : List<String>
    - normaliserChamps() : void
  }

  class FicheLABFT <<Entity>> {
    - id : Long
    - dateCreation : LocalDateTime
    - dateModification : LocalDateTime
    --
    + getDate() : LocalDate
    + getTotalRGM() : BigDecimal
    + getTotalChangeEntrant() : BigDecimal
    + getTotalChangeSortant() : BigDecimal
    + addLigne(LigneTransaction) : void
    + replaceLignes(List<LigneTransaction>) : void
  }

  class LigneTransaction <<Entity>> {
    - id : Long
    - typeJeu : TypeJeu
    - typePaiement : TypePaiement
    - typeChange : TypeChange
    - numeroSocle : Integer
    - montantRGM : BigDecimal
    - changeEntrant : BigDecimal
    - changeSortant : BigDecimal
    - observations : String
    - enregistreFrontCage : boolean
  }

  class JournalAction <<Entity, append-only>> {
    - id : Long
    - action : TypeActionJournal
    - typeEntite : TypeEntiteJournal
    - entiteId : Long
    - libelleEntite : String
    - description : String
    - horodatage : LocalDateTime
  }
}

package "model.enums" as ENUMS {
  enum RoleUtilisateur {
    CAISSIER
    RESPONSABLE_CAISSE
    MCD
  }
  enum TypeJeu {
    MAS
    JTE
    JT
  }
  enum TypePaiement {
    ESPECE
    CHEQUE
    CB
  }
  enum TypeChange {
    JETON
    PLAQUE
    TICKET
  }
  enum TypeActionJournal {
    CONNEXION
    DECONNEXION
    CREATION
    MODIFICATION
    SUPPRESSION
  }
  enum TypeEntiteJournal {
    FICHE
    CLIENT
    UTILISATEUR
  }
}

' --- Associations entre entités ---
Client "1" o-- "*" FicheLABFT       : fiches
FicheLABFT "*" --> "1" Client       : client
FicheLABFT "1" *-- "*" LigneTransaction : lignes\n«cascade=ALL, orphanRemoval»
LigneTransaction "*" --> "1" FicheLABFT : fiche
FicheLABFT "*" --> "1" Utilisateur  : creePar
FicheLABFT "*" --> "0..1" Utilisateur : modifiePar
LigneTransaction "*" --> "0..1" Utilisateur : caissier
JournalAction "*" --> "0..1" Utilisateur : utilisateur

' --- Liens entité → enum ---
Utilisateur --> RoleUtilisateur
LigneTransaction --> TypeJeu
LigneTransaction --> TypePaiement
LigneTransaction --> TypeChange
JournalAction --> TypeActionJournal
JournalAction --> TypeEntiteJournal


package "model.repository" as REPO {
  class UtilisateurRepository <<EJB Stateless>> {
    + findByIdentifiant(String) : Optional<Utilisateur>
    + findAll() : List<Utilisateur>
    + save(Utilisateur) : Utilisateur
    + existsByIdentifiant(String) : boolean
  }
  class ClientRepository <<EJB Stateless>> {
    + findAll(search) : List<Client>
    + findById(Long) : Optional<Client>
    + findSimilar(nom, prenom, dob, numPiece) : List<Client>
    + save / update / delete
    + countFiches(Long) : long
    + getDerniereActivitePourIds(List<Long>) : Map<Long,LocalDate>
  }
  class FicheLABFTRepository <<EJB Stateless>> {
    + findWithFilters(from, to, search) : List<FicheLABFT>
    + findByClientId(Long) : List<FicheLABFT>
    + findById / save / update / delete
  }
  class JournalActionRepository <<EJB Stateless>> {
    + save(JournalAction) : JournalAction
    + findAll(int limit) : List<JournalAction>
    + findByEntite(type, id) : List<JournalAction>
  }
}

package "model.service" as SVC {
  class AuthService <<EJB Stateless>>
  class SessionStore <<ApplicationScoped>> {
    - sessions : Map<token, session>
    + createSession(u) : String
    + getUtilisateur(token) : Utilisateur
    + invalidate(token) : void
  }
  class PermissionService <<EJB Stateless>> {
    + ensurePeutModifierFiche(u, fiche)
    + ensurePeutSupprimerFiche(u)
    + ensurePeutModifierClientComplet(u)
    + ensurePeutSupprimerClient(u)
    + ensurePeutListerUtilisateurs(u)
    + ensurePeutCreerUtilisateur(u, roleCible)
    + ensurePeutLireJournal(u)
    + ensurePeutImporterClients(u)
  }
  class FicheService <<EJB Stateless>>
  class ClientService <<EJB Stateless>>
  class ClientImportService <<EJB Stateless>>
  class UtilisateurService <<EJB Stateless>>
  class JournalService <<EJB Stateless>>
  class AdresseService <<EJB Stateless>>
  class GeoService <<EJB Stateless>>
  class PasswordHasher <<utility>>
}

package "controller (JAX-RS)" as CTRL {
  class AuthResource       <<@Path /auth>>
  class FicheResource      <<@Path /fiches>>
  class ClientResource     <<@Path /clients>>
  class UtilisateurResource<<@Path /utilisateurs>>
  class JournalResource    <<@Path /journal>>
  class AuthFilter         <<@Provider>>
  class CorsFilter         <<@Provider @PreMatching>>
}

' --- Dépendances Controller → Service ---
AuthResource         ..> AuthService
FicheResource        ..> FicheService
ClientResource       ..> ClientService
ClientResource       ..> ClientImportService
UtilisateurResource  ..> UtilisateurService
JournalResource      ..> JournalService
AuthFilter           ..> AuthService

' --- Dépendances Service → Repository ---
AuthService          ..> UtilisateurRepository
AuthService          ..> SessionStore
AuthService          ..> JournalService
FicheService         ..> FicheLABFTRepository
FicheService         ..> ClientRepository
FicheService         ..> PermissionService
FicheService         ..> JournalService
ClientService        ..> ClientRepository
ClientService        ..> FicheLABFTRepository
ClientService        ..> PermissionService
ClientService        ..> JournalService
ClientImportService  ..> ClientRepository
ClientImportService  ..> AdresseService
ClientImportService  ..> GeoService
ClientImportService  ..> JournalService
UtilisateurService   ..> UtilisateurRepository
UtilisateurService   ..> PermissionService
UtilisateurService   ..> JournalService
JournalService       ..> JournalActionRepository
JournalService       ..> PermissionService

@enduml
