@startuml uml_sequence_modification_fiche
title Diagramme de séquence — Modification d'une fiche LAB-FT (avec contrôle des droits temporels)

skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam ParticipantBorderColor #444

actor "Utilisateur\n(Caissier / Resp. caisse / MCD)" as user
participant "DetailFiche.jsx\n→ EditFiche.jsx" as ui
participant "api/fiches.js" as api
participant "AuthFilter" as authF
participant "FicheResource\n@Path /fiches" as ctrl
participant "PermissionService" as perm
participant "FicheService" as svc
participant "FicheLABFTRepository" as repo
participant "JournalService" as journal
database  "BD LABFTDB" as db

== Étape 1 : Chargement de la fiche ==
user -> ui : ouvre /fiches/:id/modifier
ui -> api : getFiche(id)
api -> authF : GET /api/fiches/{id}\nAuthorization: Bearer {token}
authF -> authF : valide token, récupère Utilisateur
authF -> ctrl : getFiche(id)
ctrl -> svc : getFiche(id)
svc -> repo : findById(id)
repo -> db : SELECT * FROM fiches_labft + lignes_transaction
db --> repo : FicheLABFT
svc --> ctrl : FicheDetailResponse
ctrl --> api : 200 OK
api --> ui : fiche

== Étape 2 : Garde-fou côté client (UX) ==
ui -> ui : peutModifierFiche(user.role, fiche.date)\n(réplique de la matrice backend)
note right of ui
  Règle :
   • MCD               → toujours autorisé
   • RESPONSABLE_CAISSE → fiche ≤ 31 jours
   • CAISSIER          → fiche ≤ 1 jour (J / J-1)
  Calcul : écart = jourTravailCourant − fiche.date
end note
alt Hors fenêtre autorisée
    ui --> user : toast « Vous n'avez pas le droit\nde modifier cette fiche. »
    ui -> ui : navigate(`/fiches/${id}`, replace) — redirection
else Dans la fenêtre
    ui --> user : formulaire pré-rempli\n(lignes éditables)
end

== Étape 3 : Édition et soumission ==
user -> ui : modifie / ajoute / supprime des lignes
ui -> ui : validateLignes() — RGM > 500 €, multiple de 5 €,\nn° de socle obligatoire si RGM, types cohérents
user -> ui : clique sur « Enregistrer »

ui -> api : updateFiche(id, { lignes[] })
api -> authF : PUT /api/fiches/{id}\nAuthorization: Bearer {token}
authF -> ctrl : updateFiche(id, req, utilisateur)
ctrl -> svc : updateFiche(id, req, modifiePar)

svc -> repo : findById(id)
repo -> db : SELECT * FROM fiches_labft WHERE id = ?
db --> repo : FicheLABFT
repo --> svc : FicheLABFT

== Étape 4 : Contrôle serveur des droits temporels (défense en profondeur) ==
svc -> perm : ensurePeutModifierFiche(utilisateur, fiche)
perm -> perm : si rôle = MCD → autorisé
perm -> perm : sinon écart = WorkDay.today() − fiche.date\n  CAISSIER           → ecart ≤ 1\n  RESPONSABLE_CAISSE → ecart ≤ 31
alt Rôle insuffisant OU fiche trop ancienne
    perm --> svc : throws ForbiddenException\n("Votre rôle ne vous autorise pas à modifier\ncette fiche (trop ancienne).")
    svc --> ctrl : propage
    ctrl --> api : 403 Forbidden
    api --> ui : erreur
    ui --> user : toast « Erreur : ... »
else Autorisé
    perm --> svc : ok

    == Étape 5 : Application du diff ==
    svc -> svc : fiche.setModifiePar(modifiePar)\nfiche.setDateModification(now())
    svc -> svc : snapshot des lignes existantes (avant)\n→ Map<Long, LigneSnapshot>
    loop pour chaque ligne de la requête
        alt Ligne existante (id présent et reconnu)
            svc -> svc : applyRequestToLigne(existante, req)\n— UPDATE in-place si champ différent
        else Nouvelle ligne (id null)
            svc -> svc : buildLigne(req, caissier)\nfiche.addLigne(nouvelle) — INSERT
        end
    end
    svc -> svc : retire les lignes absentes de la requête\n(orphan removal → DELETE)
    svc -> svc : descriptionDiffModification(...)\n— audit lisible
    svc -> repo : update(fiche)
    repo -> db : UPDATE fiches_labft\n+ INSERT / UPDATE / DELETE lignes_transaction
    svc -> journal : log(MODIFICATION, FICHE, id, libellé client,\ndescription du diff)
    journal -> db : INSERT INTO journal_actions
    svc --> ctrl : void
    ctrl --> api : 204 No Content
    api --> ui : ok
    ui --> user : toast « Fiche enregistrée »\nnavigation → /fiches/{id}
end

@enduml
